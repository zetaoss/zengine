{
  "name": "ZetaExtension",
  "version": "0.0.0",
  "author": ["jmnote"],
  "description": "ZetaWiki extension",
  "type": "other",
  "license-name": "Apache-2.0",
  "requires": {
    "MediaWiki": ">= 1.39.0",
    "platform": {
      "php": ">= 7.4.3"
    }
  },
  "AutoloadNamespaces": {
    "ZetaExtension\\": "includes/"
  },
  "namespaces": [
    {
      "id": 3000,
      "constant": "NS_BINDER",
      "name": "Binder"
    },
    {
      "id": 3001,
      "constant": "NS_BINDER_TALK",
      "name": "Binder_talk"
    },
    {
      "id": 3002,
      "constant": "NS_DISAMBIG",
      "name": "Disambig"
    },
    {
      "id": 3003,
      "constant": "NS_DISAMBIG_TALK",
      "name": "Disambig_talk"
    }
  ],
  "AuthManagerAutoConfig": {
    "primaryauth": {
      "OTPAuthProvider": {
        "class": "ZetaExtension\\Auth\\OTPAuthProvider"
      }
    }
  },
  "ExtensionMessagesFiles": {
    "TagMagic": "magic/TagMagic.php"
  },
  "Hooks": {
    "InternalParseBeforeLinks": "ZetaExtension\\Toc\\Toc::onInternalParseBeforeLinks",
    "MakeGlobalVariablesScript": "ZetaExtension\\Disambig\\DisambigHooks::onMakeGlobalVariablesScript",
    "PageSaveComplete": "ZetaExtension\\Collection\\CollectionHooks::onPageSaveComplete",
    "PageDeleteComplete": "ZetaExtension\\Collection\\CollectionHooks::onPageDeleteComplete",
    "PageUndeleteComplete": "ZetaExtension\\Collection\\CollectionHooks::onPageUndeleteComplete",
    "PageMoveComplete": "ZetaExtension\\Collection\\CollectionHooks::onPageMoveComplete",
    "SpecialSearchNogomatch": "ZetaExtension\\WriteRequest\\SearchHooks::onSpecialSearchNogomatch",
    "ParserFirstCallInit": "ZetaExtension\\Tag\\Tag::onParserFirstCallInit",
    "PostLoginRedirect": "ZetaExtension\\Auth\\Hooks::onPostLoginRedirect",
    "SpecialPageBeforeExecute": "ZetaExtension\\Auth\\Hooks::onSpecialPageBeforeExecute",
    "UserLogoutComplete": "ZetaExtension\\Auth\\Hooks::onUserLogoutComplete"
  },
  "JobClasses": {
    "zetaCleanupLegacyDisambig": {
      "class": "ZetaExtension\\Disambig\\CleanupLegacyDisambigJob",
      "services": ["UserFactory", "WikiPageFactory"]
    }
  },
  "RestRoutes": [
    {
      "path": "/binder/{pageid}",
      "method": "GET",
      "class": "ZetaExtension\\Binder\\RestBinder"
    },
    {
      "path": "/social/bridge",
      "method": "GET",
      "class": "ZetaExtension\\Auth\\RestSocialBridge"
    },
    {
      "path": "/social/create",
      "method": "POST",
      "class": "ZetaExtension\\Auth\\RestSocialCreate"
    }
  ],
  "ResourceFileModulePaths": {
    "localBasePath": "",
    "remoteExtPath": "ZetaExtension"
  },
  "manifest_version": 2
}
